{
  "name": "cloud-agents-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Your hardware. Your agent workspace.",
  "author": "Cloud Agents contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tests/*.test.cjs",
    "package:desktop": "electron-builder --publish never",
    "format:check": "prettier --check \"desktop/*.cjs\" \"ui/*.{html,css,js}\" \"tests/**/*.cjs\"",
    "lint:ui": "node tests/electron-ui.cjs",
    "check:ui": "npm run format:check && npm run lint:ui",
    "prepackage:desktop": "sh scripts/bundle-host.sh"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "dev.cloudagents.desktop",
    "productName": "Cloud Agents",
    "files": [
      "desktop/**",
      "ui/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "binaries": [
        "Contents/Resources/host/cloud-agents"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "build/host",
        "to": "host"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
