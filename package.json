{
  "name": "cloud-agents-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Your hardware. Your agent workspace.",
  "author": "Cloud Agents contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "package:desktop": "electron-builder --publish never",
    "format:check": "prettier --check \"desktop/*.cjs\" \"ui/*.{html,css,js}\" \"tests/*.cjs\""
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "dev.cloudagents.desktop",
    "productName": "Cloud Agents",
    "files": [
      "desktop/**",
      "ui/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
