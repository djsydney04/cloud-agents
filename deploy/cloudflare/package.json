{
  "name": "cloud-agents-cloudflare-host",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime false",
    "check": "npm run test && npm run typecheck && wrangler deploy --dry-run --containers-rollout none --outdir .wrangler/dry-run",
    "check:container": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "wrangler": "4.156.1"
  }
}
