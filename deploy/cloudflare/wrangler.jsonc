{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-agents-host",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Add a protected custom domain/route explicitly when ready to expose this host.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["CLOUD_AGENTS_TOKEN"] },
  "containers": [
    {
      "class_name": "CloudAgentsHost",
      "scheduling_policy": "durable_object",
      "images": {
        "host": { "dockerfile": "./Dockerfile", "build_context": "../.." },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CLOUD_AGENTS_HOST", "class_name": "CloudAgentsHost" },
    ],
  },
  "exports": {
    "CloudAgentsHost": { "type": "durable-object", "storage": "sqlite" },
  },
}
